# 将此文件复制为 .env 并填入实际值。
# 切勿将 .env 提交到 git —— 它包含敏感信息。

# ========== 模型配置 ==========
# 预训练权重路径（从 YOLOv7 官方下载 yolov7.pt 放到项目根目录）
WEIGHTS=yolov7.pt

# 训练用数据集配置文件路径（主办方下发后填写）
DATA=data/dataset.yaml

# 模型配置文件
CFG=cfg/training/yolov7.yaml

# 训练设备（0 表示第一块 GPU，cpu 表示纯 CPU）
DEVICE=0

# ========== 训练超参 ==========
EPOCHS=100
BATCH_SIZE=16
IMG_SIZE=640
